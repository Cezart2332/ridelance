# Copiază în .env.hub (nu se urcă în git) și completează.

# Utilizatorul sau organizația din Docker Hub (vars.DOCKERHUB_NAMESPACE din GitHub Actions).
DOCKERHUB_NAMESPACE=
# `latest` = ultimul build din main; sau un commit anume: sha-<12 caractere>
RIDELANCE_TAG=latest

POSTGRES_DB=ridelance
POSTGRES_USER=ridelance
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32 — păstreaz-o: fișierele încărcate se criptează cu ea
ENCRYPTION_KEY=
# Același token e cerut de validator și trimis de backend.
ANAF_VALIDATOR_TOKEN=

# Calea către kitul de validare ANAF (DUKIntegrator și validatoarele).
ANAF_VALIDATORS_PATH=./backend-anaf/validators

APP_BASE_URL=http://localhost:5173
ASPNETCORE_ENVIRONMENT=Production
