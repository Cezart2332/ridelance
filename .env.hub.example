# Variabilele din docker-compose.hub.yml. În Coolify se pun în „Environment Variables”;
# local, copiază în .env.hub (nu se urcă în git) și pornește cu --env-file .env.hub.

# ─── Obligatorii ───────────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=
APP_BASE_URL=https://ridelance.ro
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32 — nu se mai schimbă după primul upload
ENCRYPTION_KEY=
ANAF_VALIDATOR_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Imagini și porturi ────────────────────────────────────────────────────────────────────
# Tag-urile din Docker Hub (cezarique/ridelance-*), câte unul pe imagine.
BACKEND_TAG=sha-89d7fdf4afd6
FRONTEND_TAG=sha-9d82b8d8b022
VALIDATOR_TAG=sha-22df4312e302
POSTGRES_DB=ridelance
POSTGRES_USER=ridelance
BACKEND_PORT=5000
FRONTEND_PORT=5173
ANAF_VALIDATORS_PATH=./backend-anaf/validators

# ─── Echipă ────────────────────────────────────────────────────────────────────────────────
BOOTSTRAP_ADMIN_EMAIL=
RESET_TWO_FACTOR_EMAIL=

# ─── Integrări (goale = funcția oprită) ────────────────────────────────────────────────────
RESEND_API_KEY=
OPENROUTER_API_KEY=
ANAF_OAUTH_CLIENT_ID=
ANAF_OAUTH_CLIENT_SECRET=
ANAF_OAUTH_REDIRECT_URI=https://api.ridelance.ro/anaf/oauth/callback
# Mandatarul din împuternicirea ANAF (date personale: doar în .env-ul serverului)
ANAF_MANDATAR_FULL_NAME=
ANAF_MANDATAR_CNP=
ANAF_MANDATAR_DOMICILE=
ANAF_MANDATAR_ID_SERIES=
ANAF_MANDATAR_ID_NUMBER=
ANAF_MANDATAR_EMAIL=
OBLIO_CLIENT_ID=
OBLIO_CLIENT_SECRET=
OBLIO_CIF=
OBLIO_SERIES_NAME=
OBLIO_SEND_TO_SPV=false
SMARTACCOUNTS_CLIENT_ID=
SMARTACCOUNTS_API_BASE_URL=https://api.sandboxaccounts.smartfintech.eu
SMARTACCOUNTS_MTLS_BASE_URL=https://mtls.sandboxaccounts.smartfintech.eu
SMARTACCOUNTS_CERTIFICATE_PEM=
SMARTACCOUNTS_PRIVATE_KEY_PEM=
FISCALLINK_MANAGEMENT_KEY=
FISCALLINK_COMMAND_KEY=
ELDRIVE_API_KEY=
# Codurile SMS prin Twilio Verify (Console → Verify → Services → VA…)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Emailul operațional per client (prenume.nume@pfa.ridelance.ro), pe Migadu.
# MAILBOX_PROVIDER: Migadu | Fake (în memorie, fără apeluri reale; doar pentru probe).
# Cu Migadu, adresele se creează automat abia după ce sunt puse MIGADU_API_USER, MIGADU_API_KEY
# și MAILBOX_CREDENTIALS_KEY.
MAILBOX_PROVIDER=Migadu
MIGADU_API_USER=
MIGADU_API_KEY=
MIGADU_DOMAIN=pfa.ridelance.ro
MIGADU_DAILY_INCOMING_LIMIT=200
MIGADU_DAILY_OUTGOING_LIMIT=20
# Cheia cu care se criptează parolele de mailbox. Odată pusă, nu se mai schimbă.
MAILBOX_CREDENTIALS_KEY=
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=
CARS_VIEW_SALT=

# ─── Onboarding (lasă false în producție) ──────────────────────────────────────────────────
ONBOARDING_ENABLE_TEST_SKIP=false
ONBOARDING_DEV_TOOLS=false
ONBOARDING_AUTO_APPROVE_DOCUMENTS=false
ONBOARDING_REQUIRE_CONTACT_VERIFICATION=false
