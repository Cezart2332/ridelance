# Build-ul aplicației mobile: `npm run build:native` (vezi src/native/platform.ts).
VITE_NATIVE_APP=true
# Adresa publică a API-ului. Nu e un secret: ajunge oricum în codul aplicației.
# Pentru un build de test pe alt server, suprascrie-o în .env.native.local (necomis).
VITE_API_BASE_URL=https://api.ridelance.ro
